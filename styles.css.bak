:root {
  --bg: #14171c;
  --panel: #1c2028;
  --panel-2: #23283333;
  --cork: #1a1d24;
  --border: #333a47;
  --text: #e8e9ed;
  --muted: #9aa1b1;
  --accent: #4ea1ff;
  --grade-a: #35c46b;
  --grade-b: #e8b84b;
  --grade-c: #e05a5a;
  --grade-d: #7a7f8c;
  --victim: #4ea1ff;
  --defendant: #e05a5a;
  --system: #9b7de0;
  --security: #35c46b;
  --law_enforcement: #4ea1ff;
  --investigator: #52c7c1;
  --judiciary_medical: #c98be0;
  --prosecution: #e0a04e;
  --defense: #e05a5a;
  --associate: #e8b84b;
  --witness: #9aa1b1;
  --other: #6b7280;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
}

.topbar {
  padding: 20px 28px 0 28px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, #191c22, #14171c);
}

.brand { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
.brand h1 { font-size: 1.25rem; margin: 0; }
.brand .subtitle { margin: 2px 0 0 0; color: var(--muted); font-size: 0.85rem; }
.pin { font-size: 1.6rem; }

.tabs { display: flex; gap: 4px; }
.tab-btn {
  background: none;
  border: none;
  color: var(--muted);
  padding: 10px 16px;
  font-size: 0.9rem;
  cursor: pointer;
  border-bottom: 2px solid transparent;
}
.tab-btn.active { color: var(--text); border-bottom-color: var(--accent); }
.tab-btn:hover { color: var(--text); }

main { padding: 20px 28px 40px 28px; max-width: 1400px; margin: 0 auto; }

.tab-panel { display: none; }
.tab-panel.active { display: block; }

.panel-intro {
  background: var(--panel);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  padding: 12px 16px;
  border-radius: 6px;
  font-size: 0.87rem;
  color: var(--muted);
  margin-bottom: 16px;
}
.panel-intro strong { color: var(--text); }
.panel-intro.warn { border-left-color: var(--grade-c); }

.map-layout { display: grid; grid-template-columns: 1fr 320px; gap: 16px; }
.graph-wrap {
  background:
    radial-gradient(circle at 1px 1px, #2a2f3a 1px, transparent 1px);
  background-size: 22px 22px;
  background-color: var(--cork);
  border: 1px solid var(--border);
  border-radius: 8px;
  height: 620px;
  overflow: hidden;
}
#graph { width: 100%; height: 100%; }

.node circle, .node rect { cursor: grab; }
.node text { fill: var(--text); font-size: 11px; pointer-events: none; }
.hub-node text { font-size: 13px; font-weight: 600; }
.link { stroke: #566078; stroke-width: 1.4px; }
.link.unverified { stroke-dasharray: 4 3; opacity: 0.55; }

.detail-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  font-size: 0.87rem;
  height: 620px;
  overflow-y: auto;
}
.detail-card .placeholder { color: var(--muted); }
.detail-card h3 { margin-top: 0; }
.detail-card .tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 0.72rem;
  margin: 2px 4px 2px 0;
  background: var(--panel-2);
  border: 1px solid var(--border);
}
.detail-card a { color: var(--accent); }
.detail-card dt { color: var(--muted); margin-top: 8px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
.detail-card dd { margin: 2px 0 0 0; }

.legend { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; font-size: 0.78rem; color: var(--muted); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }

.stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 16px; }
.stat-tile {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px 14px;
}
.stat-tile .num { font-size: 1.5rem; font-weight: 700; }
.stat-tile .label { color: var(--muted); font-size: 0.75rem; }
.stat-tile.grade-a .num { color: var(--grade-a); }
.stat-tile.grade-b .num { color: var(--grade-b); }
.stat-tile.grade-c .num { color: var(--grade-c); }

/* ---- Official conduct tracker ---- */
.conduct-filters { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 16px; }

.cat-block { margin-bottom: 22px; border-left: 3px solid var(--border); padding-left: 14px; }
.cat-block.cat-c { border-left-color: var(--grade-c); }
.cat-block.cat-b { border-left-color: var(--grade-b); }
.cat-block.cat-a { border-left-color: var(--grade-a); }
.cat-head h3 { margin: 0 0 3px 0; font-size: 0.98rem; }
.cat-count { font-size: 0.72rem; background: var(--panel-2); border: 1px solid var(--border); border-radius: 9px; padding: 1px 8px; margin-left: 6px; color: var(--muted); }
.cat-head p { margin: 0 0 12px 0; font-size: 0.79rem; color: var(--muted); line-height: 1.45; }

.conduct-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 13px 15px;
  margin-bottom: 10px;
}
.conduct-card.sev-3 { border-left: 3px solid var(--grade-c); }
.conduct-card.sev-2 { border-left: 3px solid var(--grade-b); }
.conduct-card.sev-1 { border-left: 3px solid var(--border); }
.conduct-card.flag-key { border-left-color: var(--accent); }

.cc-head { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; margin-bottom: 7px; }
.cc-id { font-family: ui-monospace, monospace; font-size: 0.7rem; color: var(--muted); background: rgba(0,0,0,0.25); padding: 1px 6px; border-radius: 4px; }
.cc-head h4 { margin: 0; font-size: 0.94rem; flex: 1; min-width: 200px; }
.cc-date { font-size: 0.74rem; color: var(--muted); font-family: ui-monospace, monospace; }

.cc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
.actor-badge { font-size: 0.68rem; padding: 2px 8px; border-radius: 9px; background: rgba(78,161,255,0.13); border: 1px solid var(--accent); color: var(--accent); }
.status-badge { font-size: 0.68rem; padding: 2px 8px; border-radius: 9px; background: var(--panel-2); border: 1px solid var(--border); color: var(--text); }
.verif-badge { font-size: 0.66rem; padding: 2px 8px; border-radius: 9px; border: 1px solid var(--border); }
.verif-badge.v-direct { background: rgba(53,196,107,0.13); border-color: var(--grade-a); color: var(--grade-a); }
.verif-badge.v-reported { background: rgba(232,184,75,0.12); border-color: var(--grade-b); color: var(--grade-b); }
.verif-badge.v-needs_docket { background: rgba(224,90,90,0.12); border-color: var(--grade-c); color: var(--grade-c); }

.cc-what { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0 0 8px 0; }
.cc-note, .cc-resolve { font-size: 0.8rem; color: var(--muted); line-height: 1.5; margin: 0 0 7px 0; padding-left: 10px; border-left: 2px solid var(--border); }
.cc-note strong, .cc-resolve strong { color: var(--text); }
.cc-caution { border-left-color: var(--grade-b); }
.cc-resolve { border-left-color: var(--grade-a); }
.cc-src { display: flex; gap: 12px; font-size: 0.75rem; }
.cc-src a { color: var(--accent); }

/* ---- Aviation claims tracker ---- */
.tracker-block { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin-bottom: 18px; }
.tracker-block h3 { margin: 0 0 8px 0; font-size: 1rem; }
.tracker-block h4 { margin: 16px 0 8px 0; font-size: 0.9rem; }

.negative-findings { background: rgba(0,0,0,0.22); border: 1px solid var(--border); border-left: 3px solid var(--grade-c); border-radius: 6px; padding: 12px 14px; margin: 14px 0; }
.negative-findings h4 { margin: 0 0 8px 0 !important; }
.extract-method { font-size: 0.74rem; color: var(--muted); margin: 10px 0 0 0; line-height: 1.45; font-family: ui-monospace, monospace; }

.plane-card { background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 8px; padding: 14px; margin: 14px 0; }
.plane-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
.plane-head h4 { margin: 0 !important; font-size: 1.15rem; font-family: ui-monospace, monospace; letter-spacing: 0.06em; }
.hex-badge { font-size: 0.7rem; font-family: ui-monospace, monospace; padding: 2px 8px; border-radius: 9px; background: rgba(82,199,193,0.15); border: 1px solid var(--investigator); color: var(--investigator); }

.plane-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.plane-grid h5 { margin: 0 0 7px 0; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
.checked { text-transform: none; letter-spacing: 0; opacity: 0.7; font-weight: 400; }

.reg-table, .claims-mini { width: 100%; font-size: 0.78rem; margin-bottom: 8px; }
.reg-table th { width: 38%; color: var(--muted); font-weight: 500; text-transform: none; letter-spacing: 0; font-size: 0.76rem; padding: 5px 8px 5px 0; }
.reg-table td { padding: 5px 0; }
.claims-mini th { font-size: 0.66rem; padding: 4px 6px 4px 0; }
.claims-mini td { padding: 4px 6px 4px 0; }
.claims-mini tr.out-scope { opacity: 0.45; }
.claims-mini .badge { position: static; width: 18px; height: 18px; font-size: 0.64rem; display: inline-flex; }

.reg-link { font-size: 0.76rem; color: var(--accent); }
.plane-assert { font-size: 0.81rem; color: var(--muted); line-height: 1.5; margin: 0 0 8px 0; }
.src-type { font-size: 0.72rem; color: var(--muted); font-style: italic; margin: 4px 0 0 0; }

.plane-verdict { margin-top: 14px; padding: 12px 14px; border-radius: 6px; background: rgba(78,161,255,0.08); border: 1px solid var(--accent); }
.plane-verdict h5 { margin: 0 0 8px 0; font-size: 0.88rem; color: var(--text); }
.plane-next { margin-top: 10px; }
.plane-next summary { cursor: pointer; font-size: 0.8rem; color: var(--muted); padding: 6px 0; }

.bottom-line { background: rgba(232,184,75,0.1); border: 1px solid var(--grade-b); border-radius: 6px; padding: 13px 15px; margin: 16px 0; }
.bottom-line h4 { margin: 0 0 6px 0 !important; }
.bottom-line p { margin: 0; font-size: 0.85rem; line-height: 1.6; color: var(--muted); }

.charcheck { background: rgba(155,125,224,0.09); border: 1px solid var(--system); border-radius: 6px; padding: 13px 15px; margin: 16px 0; }
.charcheck h4 { margin: 0 0 8px 0 !important; }
.charcheck p { font-size: 0.84rem; color: var(--muted); line-height: 1.55; margin: 8px 0 0 0; }
.charcheck strong { color: var(--text); }
.term-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 4px; }
.term-chip { font-size: 0.72rem; font-family: ui-monospace, monospace; padding: 3px 9px; border-radius: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--system); color: #c9b3f0; }

/* ADS-B archive panel */
.adsb-archive-panel { margin: 24px 0; padding: 20px; background: var(--panel); border: 1px solid var(--border); border-radius: 10px; }
.adsb-archive-panel h3 { margin: 0 0 8px; font-size: 1.15rem; }
.archive-source { font-size: 0.78rem; color: var(--muted); margin-bottom: 14px; }
.archive-source a { color: var(--accent); }
.flight-track-wrap { margin: 18px 0; padding: 16px; background: var(--cork); border-radius: 8px; border: 1px solid var(--border); }
.flight-track-wrap h4 { margin: 0 0 8px; font-size: 0.95rem; }
#flight-track-svg { width: 100%; height: auto; display: block; }
.flight-legend { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 8px; font-size: 0.78rem; color: var(--muted); }
.fl-legend-item { display: flex; align-items: center; gap: 5px; }
.fl-swatch { display: inline-block; width: 14px; height: 4px; border-radius: 2px; }

/* Specific aircraft cards */
.specific-aircraft-section { margin: 20px 0; }
.specific-aircraft-section h4 { margin-bottom: 8px; }
.specific-card { margin: 12px 0; padding: 16px; background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 8px; }
.specific-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
.specific-head h5 { margin: 0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.specific-type { font-size: 0.78rem; color: var(--muted); }
.country-badge { font-size: 0.7rem; padding: 1px 6px; border-radius: 3px; background: #2a3040; color: var(--text); border: 1px solid var(--border); }
.flag-badge { font-size: 0.65rem; padding: 2px 6px; border-radius: 3px; color: #14171c; font-weight: 700; letter-spacing: 0.5px; }
.specific-assess { font-size: 0.82rem; color: var(--muted); margin: 4px 0 8px; }
.adelson-search { margin: 16px 0; padding: 14px; background: var(--cork); border-radius: 8px; border: 1px solid var(--border); }
.adelson-search h5 { margin: 0 0 6px; }
.adelson-result { font-size: 0.95rem; }

.specific-ext-ctx { margin: 10px 0; padding: 10px 14px; background: var(--cork); border-radius: 6px; border-left: 3px solid var(--grade-b); }
.specific-ext-ctx h5 { margin: 0 0 4px; font-size: 0.85rem; color: var(--grade-b); }
.specific-ext-ctx p { margin: 0; font-size: 0.9rem; line-height: 1.5; }
.specific-sources { margin: 8px 0 0; }
.specific-sources h5 { margin: 0 0 4px; font-size: 0.85rem; }
.specific-sources ul { margin: 0; padding-left: 18px; }
.specific-sources li { font-size: 0.85rem; margin-bottom: 2px; }
.specific-sources a { color: var(--link); }

.private-jets-section { margin: 16px 0; }
.private-jets-section summary { cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 8px 0; }
.private-jets-table { margin-top: 10px; font-size: 0.85rem; }
.private-jets-table th { white-space: nowrap; }
.pj-commercial td { opacity: 0.6; }

.flagged-section { margin: 24px 0; }
.flagged-section h4 { margin: 0 0 8px; }
.flagged-stats { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 16px; }
.flagged-stat { padding: 4px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; border: 2px solid; background: var(--cork); }
.flagged-card { background: var(--panel); border: 1px solid var(--border); border-left: 4px solid; border-radius: 8px; padding: 14px 16px; margin-bottom: 12px; }
.flagged-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; }
.flagged-head h5 { margin: 0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.flagged-details { margin: 8px 0; font-size: 0.88rem; }
.flagged-details th { width: 110px; white-space: nowrap; }
.flagged-reason { margin-top: 10px; padding: 10px 12px; background: var(--cork); border-radius: 6px; }
.flagged-reason h5 { margin: 0 0 4px; font-size: 0.85rem; color: #e05252; }
.flagged-reason p { margin: 0; font-size: 0.9rem; line-height: 1.5; }
.flag-priority { background: #e05252; color: #fff; font-size: 0.7em; padding: 2px 6px; border-radius: 4px; font-weight: 700; }
.uvu-shutdown { margin: 16px 0; padding: 14px; background: var(--cork); border-radius: 8px; border: 1px solid var(--border); border-left: 4px solid #52c7c1; }
.uvu-shutdown h5 { margin: 0 0 6px; }
.uvu-tail-list { font-size: 0.9rem; margin: 6px 0; }

.avail-head { margin-top: 20px !important; }
.avail-table { font-size: 0.79rem; }
.avail-table td { vertical-align: top; }
.avail-badge { font-size: 0.64rem; font-weight: 700; padding: 2px 8px; border-radius: 9px; white-space: nowrap; }
.avail-badge.avail-yes { background: var(--grade-a); color: #14171c; }
.avail-badge.avail-no { background: var(--grade-c); color: #14171c; }
.avail-badge.avail-cond { background: var(--grade-b); color: #14171c; }
.mini-list { margin: 6px 0; padding-left: 16px; }
.mini-list li { font-size: 0.74rem; color: var(--muted); line-height: 1.45; margin-bottom: 3px; }

@media (max-width: 760px) { .plane-grid { grid-template-columns: 1fr; } }

/* ---- ADS-B flight methods ---- */
.cause-buttons { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 7px; margin-bottom: 14px; }
.cause-btn {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 8px 10px;
  cursor: pointer;
  text-align: left;
  color: var(--muted);
  transition: border-color 0.12s, background 0.12s;
}
.cause-btn:hover { border-color: var(--accent); }
.cause-btn.active { border-color: var(--accent); background: rgba(78,161,255,0.1); color: var(--text); }
.cause-label { display: block; font-size: 0.79rem; font-weight: 600; }
.cause-short { display: block; font-size: 0.68rem; opacity: 0.75; margin-top: 1px; }

.adsb-stage { background: #12151a; border: 1px solid var(--border); border-radius: 6px; padding: 6px; }
#adsb-track { width: 100%; height: auto; display: block; }

.adsb-verdict {
  margin-top: 12px; padding: 11px 13px; border-radius: 6px;
  font-size: 0.83rem; line-height: 1.5; border: 1px solid var(--border);
}
.adsb-verdict.ok { background: rgba(78,161,255,0.09); border-color: var(--accent); }
.adsb-verdict.danger { background: rgba(224,90,90,0.12); border-color: var(--grade-c); }

.adsb-card { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 13px 15px; margin-top: 14px; }
.adsb-card-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
.adsb-card-head h4 { margin: 0; font-size: 0.95rem; }
.freq-badge { font-size: 0.68rem; padding: 2px 8px; border-radius: 9px; background: rgba(232,184,75,0.15); border: 1px solid var(--grade-b); color: var(--grade-b); }
.adsb-card p { font-size: 0.84rem; color: var(--muted); line-height: 1.55; margin: 0 0 8px 0; }
.adsb-card dt { color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 8px; }
.adsb-card dd { margin: 2px 0 0 0; font-size: 0.84rem; }

.baserate-block, .registry-block {
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 8px; padding: 16px; margin-top: 18px;
}
.baserate-block h3, .registry-block h3 { margin: 0 0 10px 0; font-size: 1rem; }
.baserate-block h4, .registry-block h4 { margin: 16px 0 8px 0; font-size: 0.88rem; }

.causation-callout {
  background: rgba(224,90,90,0.09); border: 1px solid var(--grade-c);
  border-radius: 6px; padding: 12px 14px; margin: 14px 0;
}
.causation-callout h4 { margin: 0 0 6px 0 !important; font-size: 0.88rem; }
.causation-callout p { margin: 0; font-size: 0.84rem; color: var(--muted); line-height: 1.55; }

.evidence-list { margin: 0; padding-left: 20px; }
.evidence-list li { font-size: 0.84rem; color: var(--muted); line-height: 1.5; margin-bottom: 6px; }
.caveat-list li { color: var(--grade-b); }

.registry-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-top: 10px; }
.registry-step { background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 6px; padding: 11px 13px; }
.registry-step h4 { margin: 0 0 5px 0 !important; font-size: 0.84rem; }
.registry-step a { color: var(--accent); text-decoration: none; }
.registry-step p { margin: 0; font-size: 0.78rem; color: var(--muted); line-height: 1.45; }
.registry-example {
  margin-top: 14px; padding: 11px 13px; border-radius: 6px;
  background: rgba(78,161,255,0.08); border: 1px solid var(--accent);
  font-size: 0.83rem; line-height: 1.55; color: var(--muted);
}
.registry-example strong { color: var(--text); }

/* ---- Court timeline ---- */
.case-header {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 14px 16px;
  margin-bottom: 14px;
}
.case-header h2 { margin: 0 0 8px 0; font-size: 1.05rem; }
.case-meta { display: flex; flex-wrap: wrap; gap: 16px; font-size: 0.8rem; color: var(--muted); margin-top: 4px; }
.case-meta strong { color: var(--text); font-weight: 600; }
.case-meta a { color: var(--accent); }

.evidence-callout {
  background: rgba(78,161,255,0.08);
  border: 1px solid var(--accent);
  border-radius: 8px;
  padding: 14px 16px;
  margin-bottom: 16px;
}
.evidence-callout h3 { margin: 0 0 8px 0; font-size: 0.95rem; }
.evidence-callout p { margin: 0; font-size: 0.85rem; line-height: 1.55; color: var(--muted); }

.timeline-filters { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 16px; }

.timeline { position: relative; }
.tl-entry {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
}
.tl-date { text-align: right; padding-top: 2px; }
.tl-d { display: block; font-size: 0.82rem; font-weight: 600; }
.tl-t { display: block; font-size: 0.72rem; color: var(--muted); }
.tl-body { border-left: 2px solid var(--border); padding-left: 16px; }
.tl-entry.prov-official .tl-body { border-left-color: var(--grade-a); }
.tl-entry.prov-reported .tl-body { border-left-color: var(--grade-b); }
.tl-entry.prov-disputed .tl-body { border-left-color: var(--grade-c); }
.tl-entry.flag-key .tl-body { border-left-color: var(--accent); border-left-width: 3px; }

.tl-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 5px; }
.tl-track { font-size: 0.66rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
.prov-badge { font-size: 0.66rem; padding: 1px 7px; border-radius: 8px; font-weight: 700; text-transform: uppercase; }
.prov-badge.prov-official { background: var(--grade-a); color: #14171c; }
.prov-badge.prov-reported { background: var(--grade-b); color: #14171c; }
.prov-badge.prov-disputed { background: var(--grade-c); color: #14171c; }
.tl-flag { font-size: 0.66rem; padding: 1px 7px; border-radius: 8px; background: rgba(232,184,75,0.2); border: 1px solid var(--grade-b); color: var(--grade-b); }
.tl-flag.disc { background: rgba(224,90,90,0.15); border-color: var(--grade-c); color: var(--grade-c); }
.tl-flag.key { background: rgba(78,161,255,0.15); border-color: var(--accent); color: var(--accent); }

.tl-body h4 { margin: 0 0 5px 0; font-size: 0.92rem; }
.tl-body p { margin: 0 0 6px 0; font-size: 0.83rem; color: var(--muted); line-height: 1.5; }
.tl-why { border-left: 2px solid var(--border); padding-left: 10px; font-size: 0.79rem !important; font-style: italic; }
.tl-why strong { color: var(--text); font-style: normal; }
.tl-src { display: flex; gap: 12px; font-size: 0.75rem; }
.tl-src a { color: var(--accent); }
.tl-src .nosrc { color: var(--muted); font-style: italic; }

@media (max-width: 720px) {
  .tl-entry { grid-template-columns: 1fr; }
  .tl-date { text-align: left; }
}

/* ---- Normalization demo ---- */
.demo-block {
  background: var(--panel);
  border: 1px solid var(--border);
  border-left: 3px solid var(--grade-b);
  border-radius: 8px;
  margin-bottom: 18px;
}
.demo-block summary {
  padding: 12px 16px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.92rem;
  list-style: none;
}
.demo-block summary::-webkit-details-marker { display: none; }
.demo-icon { margin-right: 6px; }
.demo-body { padding: 0 16px 18px 16px; }
.demo-lede { font-size: 0.86rem; color: var(--muted); line-height: 1.5; }
.demo-lede strong { color: var(--text); }

.demo-interactive {
  background: rgba(0,0,0,0.2);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 14px;
  margin: 14px 0;
}
.demo-interactive label { font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 8px; }
.demo-interactive output { color: var(--grade-b); font-weight: 700; font-size: 1.05rem; margin-left: 6px; }
#volume-slider { width: 100%; accent-color: var(--accent); }
.slider-ticks { display: flex; justify-content: space-between; font-size: 0.68rem; color: var(--muted); margin-top: 2px; }

.demo-charts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
.demo-chart-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 10px;
}
.demo-chart-card h4 { margin: 0 0 6px 0; font-size: 0.78rem; color: var(--muted); font-weight: 600; }
.demo-chart-card svg { width: 100%; height: auto; display: block; }
.chart-note { font-size: 0.72rem; color: var(--muted); margin: 6px 0 0 0; line-height: 1.4; }

.demo-punchline {
  margin-top: 14px;
  padding: 11px 13px;
  border-radius: 6px;
  font-size: 0.83rem;
  line-height: 1.5;
  border: 1px solid var(--border);
}
.demo-punchline.danger { background: rgba(224,90,90,0.12); border-color: var(--grade-c); }
.demo-punchline.warn { background: rgba(232,184,75,0.1); border-color: var(--grade-b); }
.demo-punchline.ok { background: rgba(53,196,107,0.1); border-color: var(--grade-a); }

.demo-explainer h4 { margin: 16px 0 8px 0; font-size: 0.9rem; }
.demo-table { font-size: 0.79rem; }
.demo-table th { font-size: 0.7rem; }

@media (max-width: 720px) {
  .demo-charts { grid-template-columns: 1fr; }
}

.claims-controls { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; align-items: center; }
.claims-controls input, .claims-controls select {
  background: var(--panel);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 8px 10px;
  border-radius: 6px;
  font-size: 0.85rem;
}
.claims-controls input { flex: 1; min-width: 200px; }
.chk { color: var(--muted); font-size: 0.85rem; display: flex; align-items: center; gap: 6px; }

.claims-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.claim-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px 14px;
  position: relative;
}
.claim-card.grade-b { opacity: 0.92; }
.claim-card.grade-c { opacity: 0.72; }
.claim-card .badge {
  position: absolute; top: 10px; right: 10px;
  font-size: 0.7rem; font-weight: 700;
  width: 22px; height: 22px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #14171c;
}
.badge.grade-a { background: var(--grade-a); }
.badge.grade-b { background: var(--grade-b); }
.badge.grade-c { background: var(--grade-c); }
.badge.grade-d { background: var(--grade-d); }
.claim-card h4 { margin: 0 18px 4px 0; font-size: 0.95rem; }
.claim-card .meta { color: var(--muted); font-size: 0.76rem; margin-bottom: 6px; }
.claim-card .caveat { font-size: 0.78rem; color: #e8b84b; border-top: 1px dashed var(--border); margin-top: 8px; padding-top: 6px; }
.claim-card a { color: var(--accent); font-size: 0.76rem; }

.controls-panel { margin-top: 24px; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
.controls-panel.hidden { display: none; }

table { width: 100%; border-collapse: collapse; font-size: 0.83rem; margin-bottom: 24px; }
table th, table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
table th { color: var(--muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em; }
table tr:hover td { background: rgba(255,255,255,0.02); }
.tier-badge { padding: 1px 7px; border-radius: 8px; font-size: 0.72rem; font-weight: 700; }
.tier-badge.tier-A, .tier-badge.tier-A- { background: var(--grade-a); color: #14171c; }
.tier-badge.tier-B { background: var(--grade-b); color: #14171c; }
.tier-badge.tier-C { background: var(--grade-c); color: #14171c; }

footer { padding: 16px 28px 30px; color: var(--muted); font-size: 0.78rem; text-align: center; border-top: 1px solid var(--border); }

/* ==================== ASSESSMENT / NETWORK / CONTESTED TABS ==================== */

.assess-h, .net-group-h {
  margin: 28px 0 10px; padding-bottom: 6px;
  border-bottom: 1px solid var(--border); font-size: 1.05rem;
}
.net-count {
  background: var(--cork); border: 1px solid var(--border); border-radius: 10px;
  padding: 1px 8px; font-size: 0.8rem; color: var(--muted); margin-left: 6px;
}

/* --- Assessment headline --- */
.assess-headline {
  background: var(--panel); border: 1px solid var(--border);
  border-left: 4px solid var(--accent); border-radius: 8px; padding: 16px 18px; margin: 16px 0;
}
.assess-headline h3 { margin: 0 0 8px; }
.assess-headline p { margin: 0 0 12px; line-height: 1.6; }
.assess-bridge {
  background: var(--cork); border-radius: 6px; padding: 12px 14px;
  border-left: 3px solid var(--grade-c);
}
.assess-bridge h4 { margin: 0 0 6px; font-size: 0.9rem; color: var(--grade-c); }
.assess-bridge p { margin: 0; font-size: 0.92rem; }
.reconstruction {
  background: var(--cork); border: 1px solid var(--border); border-radius: 8px;
  padding: 14px 16px; line-height: 1.65; font-size: 0.95rem;
}

/* --- Confidence bars --- */
.conf-block { margin: 12px 0; }
.conf-row {
  display: grid; grid-template-columns: 260px 1fr; gap: 10px 14px;
  align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border);
}
.conf-label { font-weight: 600; font-size: 0.9rem; }
.conf-track {
  position: relative; height: 22px; background: var(--cork);
  border: 1px solid var(--border); border-radius: 4px;
}
.conf-bar { position: absolute; top: 0; bottom: 0; border-radius: 3px; opacity: 0.85; }
.conf-range {
  position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
  font-size: 0.78rem; font-weight: 700; color: var(--text);
  text-shadow: 0 0 4px var(--bg);
}
.conf-note {
  grid-column: 2; font-size: 0.82rem; color: var(--muted); line-height: 1.45; margin-top: -4px;
}

/* --- Anomaly cards --- */
.anomaly-card {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--muted);
  border-radius: 8px; padding: 14px 16px; margin-bottom: 12px;
}
.anomaly-card.sev-3 { border-left-color: var(--grade-c); }
.anomaly-card.sev-2 { border-left-color: var(--grade-b); }
.anomaly-card.sev-1 { border-left-color: var(--investigator); }
.anomaly-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.anomaly-head h4 { margin: 0 0 6px; font-size: 0.98rem; }
.anomaly-status {
  font-size: 0.75rem; background: var(--cork); border: 1px solid var(--border);
  border-radius: 4px; padding: 2px 8px; color: var(--muted); white-space: nowrap;
}
.anomaly-finding { margin: 4px 0 10px; font-size: 0.92rem; line-height: 1.55; }
.anomaly-why {
  background: var(--cork); border-radius: 6px; padding: 10px 12px;
  font-size: 0.89rem; line-height: 1.55;
}
.anomaly-why p { margin: 8px 0 0; }
.records-needed {
  margin-top: 10px; padding: 10px 12px; background: var(--panel-2);
  border-left: 3px solid var(--investigator); border-radius: 4px; font-size: 0.85rem;
}
.records-needed ul { margin: 6px 0 0; padding-left: 18px; }
.records-needed li { margin-bottom: 3px; }

/* --- Convergence streams --- */
.stream-table th { width: 190px; vertical-align: top; }
.stream-weak {
  margin-top: 6px; padding: 6px 10px; background: var(--cork);
  border-left: 3px solid var(--grade-c); border-radius: 4px; font-size: 0.85rem;
}
.defense-posture {
  margin: 12px 0; padding: 12px 14px; background: var(--cork);
  border: 1px solid var(--border); border-radius: 6px; font-size: 0.9rem; line-height: 1.55;
}

/* --- Security block --- */
.security-block {
  background: var(--panel); border: 1px solid var(--border);
  border-left: 4px solid var(--grade-c); border-radius: 8px; padding: 14px 16px;
}
.security-facts { margin: 10px 0; padding-left: 20px; }
.security-facts li { margin-bottom: 5px; font-size: 0.92rem; }
.security-warn, .security-counter {
  margin: 10px 0; padding: 10px 12px; border-radius: 6px; font-size: 0.9rem; line-height: 1.55;
}
.security-warn { background: var(--cork); border-left: 3px solid var(--grade-b); }
.security-counter { background: var(--cork); border-left: 3px solid var(--investigator); }
.security-concl { font-weight: 600; margin-top: 12px; }

/* --- Control cases (Butler / JFK) --- */
.control-case {
  background: var(--cork); border: 1px solid var(--border);
  border-left: 4px solid var(--system); border-radius: 8px;
  padding: 14px 16px; margin: 16px 0;
}
.control-case h4 { margin: 0 0 8px; }
.control-case ul { padding-left: 20px; }
.control-case li { margin-bottom: 8px; font-size: 0.9rem; line-height: 1.55; }
.control-lesson {
  margin-top: 10px; padding: 10px 12px; background: var(--panel);
  border-radius: 6px; font-size: 0.9rem; line-height: 1.55;
}
.jfk-rule {
  margin: 12px 0; padding: 12px 14px; background: var(--panel);
  border-left: 4px solid var(--grade-b); border-radius: 6px;
  font-size: 1rem; font-weight: 700; text-align: center;
}

/* --- Would change / would not change --- */
.would-change {
  background: var(--panel); border: 1px solid var(--border);
  border-left: 4px solid var(--grade-a); border-radius: 8px; padding: 14px 16px;
}
.would-change h4 { margin: 0 0 8px; }
.would-change ul { margin: 0; padding-left: 20px; }
.would-change li { margin-bottom: 7px; font-size: 0.92rem; line-height: 1.5; }
.would-not-change {
  background: var(--panel); border: 1px solid var(--border);
  border-left: 4px solid var(--grade-d); border-radius: 8px;
  padding: 14px 16px; margin-top: 12px;
}
.would-not-change h4 { margin: 0 0 10px; }
.wnc-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.wnc-chip {
  background: var(--cork); border: 1px solid var(--border); border-radius: 4px;
  padding: 3px 10px; font-size: 0.82rem; color: var(--muted);
}
.would-not-change p { margin: 0; font-size: 0.9rem; line-height: 1.55; }

/* --- Institutional distrust / evidentiary ladder --- */
.distrust-block { font-size: 0.93rem; line-height: 1.6; }
.ladder {
  margin: 16px 0; padding: 14px 16px; background: var(--panel);
  border: 1px solid var(--border); border-radius: 8px;
}
.ladder h4 { margin: 0 0 6px; }
.ladder-rung {
  display: grid; grid-template-columns: 28px 150px 1fr auto; gap: 10px;
  align-items: center; padding: 8px 10px; margin-bottom: 4px;
  background: var(--cork); border-radius: 5px; font-size: 0.87rem;
}
.ladder-rung.unproven { opacity: 0.75; border-left: 3px solid var(--grade-c); }
.rung-n {
  background: var(--border); border-radius: 50%; width: 22px; height: 22px;
  display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700;
}
.rung-level { font-weight: 700; color: var(--muted); font-size: 0.8rem; }
.rung-flag {
  background: var(--grade-c); color: #fff; border-radius: 3px;
  padding: 2px 6px; font-size: 0.68rem; font-weight: 700; white-space: nowrap;
}
.ladder-closing { margin: 10px 0 0; font-size: 0.88rem; color: var(--muted); line-height: 1.55; }
.better-question {
  background: var(--cork); border-left: 4px solid var(--accent);
  border-radius: 6px; padding: 12px 14px; margin-top: 12px;
}
.better-question h4 { margin: 0 0 6px; }
.better-question p { margin: 0; font-size: 0.92rem; line-height: 1.6; }

/* --- Precedent --- */
.precedent-card {
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 8px; padding: 12px 14px; margin-bottom: 10px;
}
.precedent-card h5 { margin: 0 0 6px; font-size: 0.95rem; }
.precedent-card p { margin: 0; font-size: 0.9rem; line-height: 1.55; }
.prec-year { color: var(--muted); font-weight: 400; }
.prec-fit {
  background: var(--cork); border: 1px solid var(--border); border-radius: 4px;
  padding: 2px 8px; font-size: 0.72rem; color: var(--grade-b); margin-left: 6px;
}
.prec-non, .prec-caution { font-size: 0.88rem; color: var(--muted); line-height: 1.55; }

.bottom-line {
  background: var(--panel); border: 2px solid var(--accent);
  border-radius: 8px; padding: 16px 18px; margin: 24px 0;
}
.bottom-line h3 { margin: 0 0 8px; }
.bottom-line p { margin: 0 0 10px; line-height: 1.65; }
.next-milestone {
  background: var(--cork); border: 1px solid var(--border);
  border-left: 4px solid var(--grade-b); border-radius: 6px; padding: 12px 14px;
}
.next-milestone h4 { margin: 0 0 6px; }
.next-milestone p { margin: 0; font-size: 0.9rem; line-height: 1.55; }

/* --- Network: tiers and person cards --- */
.tier-legend {
  background: var(--cork); border: 1px solid var(--border);
  border-radius: 8px; padding: 12px 14px; margin: 14px 0;
}
.tier-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
.tier-chip {
  border: 2px solid; border-radius: 4px; padding: 3px 10px;
  font-size: 0.82rem; font-weight: 600; background: var(--panel); cursor: help;
}
.tier-note { margin: 6px 0 0; font-size: 0.85rem; color: var(--muted); }

.person-card {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid;
  border-radius: 8px; padding: 14px 16px; margin-bottom: 12px;
}
.person-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.person-head h4 { margin: 0; font-size: 1rem; }
.tier-badge {
  color: #14171c; border-radius: 4px; padding: 2px 9px;
  font-size: 0.72rem; font-weight: 700; white-space: nowrap;
}
.person-role { color: var(--muted); font-size: 0.87rem; margin: 4px 0 10px; }
.person-finding, .person-detail, .person-signif, .person-negative {
  font-size: 0.9rem; line-height: 1.58; margin-bottom: 8px;
}
.person-detail { color: var(--muted); }
.person-signif {
  background: var(--cork); border-left: 3px solid var(--grade-b);
  border-radius: 4px; padding: 9px 12px;
}
.person-negative {
  background: var(--cork); border-left: 3px solid var(--investigator);
  border-radius: 4px; padding: 9px 12px; color: var(--muted);
}

/* --- Network: edges table --- */
.edge-table-wrap { overflow-x: auto; }
.edge-table, .hammer-table, .prop-table { font-size: 0.85rem; width: 100%; }
.edge-pair { white-space: nowrap; }
.edge-type {
  color: #14171c; border-radius: 3px; padding: 2px 7px;
  font-size: 0.72rem; font-weight: 700; white-space: nowrap;
}
.edge-strength { white-space: nowrap; font-weight: 600; }
.edge-detail { line-height: 1.5; min-width: 320px; }

/* --- Network: chronology --- */
.chrono-block {
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 8px; padding: 16px 18px; margin: 20px 0;
}
.chrono-block h3 { margin: 0 0 8px; }
.chrono-step {
  display: grid; grid-template-columns: 130px 1fr; gap: 12px;
  padding: 9px 12px; margin-bottom: 4px; background: var(--cork);
  border-radius: 5px; font-size: 0.88rem; line-height: 1.5;
}
.chrono-step.flagged { border-left: 3px solid var(--grade-c); background: var(--panel-2); }
.chrono-date { font-weight: 700; color: var(--grade-b); white-space: nowrap; }
.chrono-question {
  margin: 12px 0; padding: 12px 14px; background: var(--cork);
  border-left: 4px solid var(--accent); border-radius: 6px;
  font-size: 0.9rem; line-height: 1.58;
}

/* --- Network: Hammer claims --- */
.hammer-table .hc-claim { font-weight: 600; min-width: 180px; }
.hammer-table .hc-finding { line-height: 1.5; min-width: 300px; }
.hammer-table .hc-verdict { font-weight: 700; white-space: nowrap; font-size: 0.8rem; }
.hammer-table tr.hr-high .hc-verdict { color: var(--grade-b); }
.hammer-table tr.hr-low .hc-verdict { color: var(--muted); }
.hammer-table tr.hr-none .hc-verdict { color: var(--investigator); }

.donor-transparency, .not-established-block {
  background: var(--cork); border: 1px solid var(--border);
  border-radius: 8px; padding: 14px 16px; margin: 16px 0;
}
.donor-transparency { border-left: 4px solid var(--grade-b); }
.not-established-block { border-left: 4px solid var(--investigator); }
.donor-transparency h4, .not-established-block h4 { margin: 0 0 8px; }
.donor-transparency p { margin: 0; font-size: 0.9rem; line-height: 1.6; }
.not-established-block ul { margin: 8px 0 0; padding-left: 20px; }
.not-established-block li { margin-bottom: 5px; font-size: 0.89rem; line-height: 1.5; }

.lead-row {
  display: grid; grid-template-columns: 34px 1fr; gap: 12px;
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 6px; padding: 12px 14px; margin-bottom: 8px;
}
.lead-prio {
  background: var(--accent); color: #14171c; border-radius: 50%;
  width: 26px; height: 26px; display: flex; align-items: center;
  justify-content: center; font-weight: 700; font-size: 0.85rem;
}
.lead-row p { margin: 4px 0 0; font-size: 0.88rem; color: var(--muted); line-height: 1.5; }

/* --- Contested claims --- */
.rating-chip {
  color: #14171c; border-radius: 3px; padding: 2px 8px;
  font-size: 0.74rem; font-weight: 700; white-space: nowrap; cursor: help;
}
.dispute-block {
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 8px; padding: 18px 20px; margin: 18px 0;
}
.dispute-block h3 { margin: 0 0 10px; }
.dispute-summary { font-size: 0.93rem; line-height: 1.6; }
.dispute-sub { margin: 18px 0 10px; font-size: 0.95rem; color: var(--grade-b); }
.core-problem {
  display: grid; grid-template-columns: 30px 1fr; gap: 12px;
  background: var(--cork); border-radius: 6px; padding: 12px 14px; margin-bottom: 8px;
}
.cp-n {
  background: var(--grade-c); color: #fff; border-radius: 50%;
  width: 24px; height: 24px; display: flex; align-items: center;
  justify-content: center; font-weight: 700; font-size: 0.8rem;
}
.core-problem h5 { margin: 0 0 5px; font-size: 0.92rem; }
.core-problem p { margin: 0 0 7px; font-size: 0.88rem; line-height: 1.58; }
.trajectory, .access-mech, .dispute-nuance, .separate-q {
  background: var(--cork); border-radius: 6px; padding: 12px 14px; margin: 12px 0;
}
.trajectory { border-left: 3px solid var(--grade-b); }
.access-mech { border-left: 3px solid var(--grade-c); }
.dispute-nuance { border-left: 3px solid var(--investigator); }
.separate-q { border-left: 3px solid var(--accent); }
.trajectory h5, .access-mech h5, .dispute-nuance h5, .separate-q h5 { margin: 0 0 6px; font-size: 0.9rem; }
.trajectory ol { margin: 6px 0 0; padding-left: 20px; }
.trajectory li { margin-bottom: 6px; font-size: 0.88rem; line-height: 1.5; }
.access-mech p, .dispute-nuance p, .separate-q p { margin: 0; font-size: 0.89rem; line-height: 1.58; }
.prop-table .prop-claim { min-width: 240px; }
.prop-table .prop-note { color: var(--muted); line-height: 1.45; }
.dispute-bottom, .dispute-next {
  margin-top: 14px; padding: 12px 14px; border-radius: 6px;
  font-size: 0.91rem; line-height: 1.6;
}
.dispute-bottom { background: var(--panel-2); border-left: 4px solid var(--accent); }
.dispute-next { background: var(--cork); border-left: 4px solid var(--grade-a); }

.trends-method {
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 8px; padding: 18px 20px; margin: 18px 0;
}
.trends-method h3 { margin: 0 0 8px; }
.trends-expl {
  display: grid; grid-template-columns: 30px 1fr; gap: 12px;
  background: var(--cork); border-radius: 6px; padding: 11px 14px; margin-bottom: 6px;
}
.te-rank {
  background: var(--border); border-radius: 50%; width: 24px; height: 24px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 0.78rem;
}
.trends-expl h5 { margin: 0 0 4px; font-size: 0.9rem; }
.trends-expl p { margin: 0; font-size: 0.87rem; line-height: 1.55; color: var(--muted); }
.core-distinction, .proposed-exp {
  margin: 14px 0; padding: 12px 14px; border-radius: 6px;
  font-size: 0.9rem; line-height: 1.6;
}
.core-distinction { background: var(--panel-2); border-left: 4px solid var(--grade-c); }
.proposed-exp { background: var(--cork); border-left: 4px solid var(--grade-a); }

@media (max-width: 900px) {
  .conf-row { grid-template-columns: 1fr; }
  .conf-note { grid-column: 1; }
  .ladder-rung { grid-template-columns: 24px 1fr; }
  .rung-level { grid-column: 2; }
  .chrono-step { grid-template-columns: 1fr; gap: 4px; }
}

/* ==================== FACT-CHECK / PERSON TIMELINE / PLANE CROSS-CHECK ==================== */

.cf-plane-section {
  margin: 18px 0; padding: 16px 18px; background: var(--panel);
  border: 1px solid var(--border); border-radius: 8px;
}
.cf-plane-section h4 { margin: 0 0 6px; }
.cf-plane-card, .cf-claim-card {
  background: var(--cork); border: 1px solid var(--border);
  border-radius: 8px; padding: 14px 16px; margin-bottom: 12px;
}
.cf-plane-head, .cf-claim-head {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 10px; flex-wrap: wrap; margin-bottom: 6px;
}
.cf-plane-head h5, .cf-claim-head h4 { margin: 0; font-size: 0.96rem; }
.cf-claim-text { font-size: 0.9rem; color: var(--muted); margin: 4px 0 8px; }
.cf-verdict-note {
  font-size: 0.87rem; font-weight: 600; margin: 6px 0; color: var(--grade-b);
}
.cf-evidence { margin: 6px 0; padding-left: 20px; font-size: 0.87rem; line-height: 1.5; }
.cf-for-against { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 10px 0; }
.cf-for, .cf-against {
  background: var(--panel); border-radius: 6px; padding: 10px 12px;
}
.cf-for { border-left: 3px solid var(--grade-a); }
.cf-against { border-left: 3px solid var(--grade-c); }
.cf-for h5, .cf-against h5 { margin: 0 0 6px; font-size: 0.82rem; }
.cf-for ul, .cf-against ul { margin: 0; padding-left: 18px; font-size: 0.84rem; line-height: 1.5; }
.cf-for li, .cf-against li { margin-bottom: 5px; }
.cf-sources { font-size: 0.8rem; color: var(--muted); margin: 8px 0 0; }
.cf-cross-ref {
  margin-top: 10px; padding: 10px 12px; background: var(--panel-2);
  border-left: 3px solid var(--accent); border-radius: 4px;
  font-size: 0.86rem; line-height: 1.55;
}
.cf-mini-timeline { margin: 10px 0; }
.cf-tl-row {
  display: grid; grid-template-columns: 130px 1fr; gap: 10px;
  padding: 5px 8px; font-size: 0.82rem; background: var(--panel); border-radius: 4px; margin-bottom: 3px;
}
.cf-tl-date { font-weight: 700; color: var(--grade-b); white-space: nowrap; }

@media (max-width: 700px) {
  .cf-for-against { grid-template-columns: 1fr; }
}

/* --- Person timeline --- */
.pt-person-card {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--accent);
  border-radius: 8px; padding: 14px 16px; margin-bottom: 14px;
}
.pt-person-card.pt-empty { border-left-color: var(--grade-d); opacity: 0.85; }
.pt-person-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.pt-person-head h4 { margin: 0; }
.pt-role { color: var(--muted); font-size: 0.85rem; }
.pt-coverage { font-size: 0.85rem; color: var(--muted); margin: 6px 0 10px; line-height: 1.5; font-style: italic; }
.pt-none { font-size: 0.88rem; color: var(--muted); background: var(--cork); border-radius: 6px; padding: 10px 12px; margin: 0; }
.pt-entries { margin-top: 8px; }
.pt-entry {
  display: grid; grid-template-columns: 190px 1fr; gap: 12px;
  padding: 8px 10px; background: var(--cork); border-radius: 5px; margin-bottom: 5px; font-size: 0.88rem;
}
.pt-when { font-weight: 700; color: var(--grade-b); white-space: nowrap; }
.pt-event { line-height: 1.5; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
.conf-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; cursor: help; }

@media (max-width: 700px) {
  .pt-entry { grid-template-columns: 1fr; gap: 4px; }
}

/* ==================== CONTRADICTIONS SECTION ==================== */

.contra-section { margin: 20px 0; }
.contra-card {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--grade-c);
  border-radius: 8px; padding: 14px 16px; margin-bottom: 14px;
}
.contra-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
.contra-head h4 { margin: 0; font-size: 0.98rem; }
.contra-status {
  font-size: 0.75rem; background: var(--cork); border: 1px solid var(--border);
  border-radius: 4px; padding: 2px 8px; color: var(--muted); white-space: nowrap;
}
.contra-sides {
  display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px;
  align-items: stretch; margin-bottom: 10px;
}
.contra-side {
  background: var(--cork); border-radius: 6px; padding: 10px 12px;
  display: flex; gap: 10px; align-items: flex-start;
}
.contra-side.side-a { border-left: 3px solid var(--accent); }
.contra-side.side-b { border-left: 3px solid var(--grade-b); }
.side-label {
  background: var(--border); border-radius: 50%; width: 22px; height: 22px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 0.8rem; flex-shrink: 0;
}
.contra-side strong { display: block; font-size: 0.83rem; margin-bottom: 4px; }
.contra-side p { margin: 0; font-size: 0.87rem; line-height: 1.5; }
.contra-vs { display: flex; align-items: center; justify-content: center; color: var(--muted); font-weight: 700; font-size: 0.85rem; }
.contra-why {
  background: var(--panel-2); border-left: 3px solid var(--grade-c); border-radius: 4px;
  padding: 9px 12px; font-size: 0.87rem; line-height: 1.55; margin-bottom: 8px;
}
.contra-ref { font-size: 0.78rem; color: var(--muted); }

@media (max-width: 800px) {
  .contra-sides { grid-template-columns: 1fr; }
  .contra-vs { padding: 2px 0; }
}

/* ==================== FLIGHT PATHS GRID ==================== */

.flight-paths-section { margin: 24px 0; }
.flight-paths-section h4 { margin: 0 0 8px; }
.fp-ground-callout {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--grade-c);
  border-radius: 8px; padding: 12px 14px; margin: 12px 0 18px; font-size: 0.9rem; line-height: 1.55;
}
.fp-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px;
}
.fp-card {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid;
  border-radius: 8px; padding: 12px 14px;
}
.fp-card-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 4px; }
.fp-card-head h5 { margin: 0; font-size: 0.92rem; }
.fp-shoot-badge {
  background: var(--grade-c); color: #fff; border-radius: 4px; padding: 2px 7px;
  font-size: 0.65rem; font-weight: 700; letter-spacing: 0.02em;
}
.fp-card-sub { font-size: 0.8rem; color: var(--muted); margin-bottom: 6px; }
.fp-note { font-size: 0.83rem; line-height: 1.45; margin: 0 0 8px; }
.fp-svg-wrap {
  background: var(--cork); border: 1px solid var(--border); border-radius: 6px;
  overflow: hidden; margin-bottom: 8px;
}
.fp-track-svg { width: 100%; height: 190px; display: block; }
.fp-stats { font-size: 0.76rem; }
.fp-stats th { color: var(--muted); font-weight: 600; white-space: nowrap; }

/* ==================== BASE RATE TEST SECTION ==================== */

.base-rate-section {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--accent);
  border-radius: 8px; padding: 16px 18px; margin: 24px 0;
}
.base-rate-section h4 { margin: 0 0 8px; }
.br-method {
  background: var(--cork); border-radius: 6px; padding: 10px 12px;
  font-size: 0.87rem; line-height: 1.55; margin: 10px 0;
}
.br-compare { margin: 16px 0; }
.br-bar-row { display: grid; grid-template-columns: 130px 1fr 180px; gap: 10px; align-items: center; margin-bottom: 8px; }
.br-bar-label { font-size: 0.85rem; font-weight: 600; }
.br-bar-track { height: 20px; background: var(--cork); border: 1px solid var(--border); border-radius: 4px; overflow: hidden; }
.br-bar-fill { height: 100%; }
.br-bar-value { font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
.br-finding, .br-conclusion {
  border-radius: 6px; padding: 11px 13px; font-size: 0.88rem; line-height: 1.58; margin-top: 10px;
}
.br-finding { background: var(--panel-2); border-left: 3px solid var(--grade-c); }
.br-conclusion { background: var(--cork); border-left: 3px solid var(--grade-a); }

/* ==================== CONTRADICTIONS TAB + POINTER ==================== */

.contra-pointer {
  background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--grade-c);
  border-radius: 8px; padding: 14px 16px; margin: 20px 0; font-size: 0.92rem;
  display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
}
.contra-goto-btn {
  background: var(--accent); color: #14171c; border: none; border-radius: 6px;
  padding: 8px 14px; font-size: 0.85rem; font-weight: 700; cursor: pointer; white-space: nowrap;
}
.contra-goto-btn:hover { opacity: 0.85; }

.contra-grid { margin-top: 16px; }
.contra-card.contra-resolved { border-left-color: var(--grade-a); opacity: 0.92; }
.contra-card.contra-resolved .contra-status { background: rgba(53,196,107,0.15); color: var(--grade-a); border-color: var(--grade-a); }

/* ==================== SCENE SIMULATION TAB ==================== */

.sim-controls {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
  padding: 12px 16px; margin: 16px 0;
}
.sim-play-btn, .sim-reset-btn {
  background: var(--accent); color: #14171c; border: none; border-radius: 6px;
  padding: 8px 14px; font-size: 0.85rem; font-weight: 700; cursor: pointer; white-space: nowrap;
}
.sim-reset-btn { background: var(--cork); color: var(--text); border: 1px solid var(--border); }
.sim-play-btn:hover, .sim-reset-btn:hover { opacity: 0.85; }
.sim-time-readout {
  font-family: ui-monospace, monospace; font-size: 1rem; font-weight: 700;
  color: var(--grade-b); min-width: 110px;
}
.sim-slider { flex: 1; min-width: 200px; accent-color: var(--accent); }

.sim-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 16px; }
.sim-panel { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; }
.sim-panel h4 { margin: 0 0 4px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.95rem; }
.sim-panel-note { font-size: 0.78rem; color: var(--muted); margin: 0 0 8px; line-height: 1.4; }
.sim-svg-wrap { background: var(--cork); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
.sim-svg-wrap svg { width: 100%; height: 320px; display: block; }

.precision-chip {
  font-size: 0.68rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;
  text-transform: uppercase; letter-spacing: 0.02em; white-space: nowrap;
}
.precision-chip.gps { background: rgba(53,196,107,0.15); color: var(--grade-a); border: 1px solid var(--grade-a); }
.precision-chip.schematic { background: rgba(232,184,75,0.15); color: var(--grade-b); border: 1px solid var(--grade-b); }
.precision-chip.unknown { background: rgba(154,161,177,0.15); color: var(--muted); border: 1px solid var(--muted); }

.sim-detail { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; margin-bottom: 16px; }
.sim-detail h4 { margin: 14px 0 8px; font-size: 0.9rem; }
.sim-detail h4:first-child { margin-top: 0; }
.sim-event-row {
  display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
  background: var(--cork); border-radius: 6px; padding: 8px 10px; margin-bottom: 6px;
}
.sim-event-time { font-family: ui-monospace, monospace; font-size: 0.8rem; font-weight: 700; color: var(--grade-b); white-space: nowrap; }
.sim-event-row p { margin: 4px 0 0; font-size: 0.85rem; line-height: 1.5; flex-basis: 100%; }
.sim-empty { color: var(--muted); font-size: 0.85rem; font-style: italic; }
.sim-ac-table { font-size: 0.8rem; }

.conf-chip {
  font-size: 0.68rem; font-weight: 700; padding: 2px 7px; border-radius: 4px; text-transform: uppercase;
}
.conf-chip.conf-official { background: rgba(53,196,107,0.15); color: var(--grade-a); }
.conf-chip.conf-reported { background: rgba(232,184,75,0.15); color: var(--grade-b); }
.conf-chip.conf-self_reported { background: rgba(224,90,90,0.15); color: var(--grade-c); }
.conf-chip.conf-disputed { background: rgba(154,161,177,0.15); color: var(--muted); }

.sim-legend {
  background: var(--cork); border: 1px solid var(--border); border-radius: 8px;
  padding: 10px 14px; font-size: 0.82rem; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}

/* ==================== SCENE SIMULATION — PHASE 2 ENHANCEMENTS ==================== */

.sim-phase-bar { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
.phase-chip {
  background: var(--cork); border: 1px solid var(--border); border-radius: 14px;
  padding: 5px 12px; font-size: 0.76rem; color: var(--muted); font-weight: 600;
  transition: all 0.15s;
}
.phase-chip.active { background: var(--accent); color: #14171c; border-color: var(--accent); }

.sim-now {
  background: var(--panel-2); border-left: 4px solid var(--grade-b); border-radius: 6px;
  padding: 10px 14px; margin-bottom: 14px; font-size: 0.92rem; line-height: 1.5;
}

.sim-panel-wide { grid-column: span 2; }
@media (min-width: 900px) {
  .sim-panels { grid-template-columns: 1.4fr 1fr; }
}
.sim-panel-wide .sim-svg-wrap svg { height: 420px; }

.precision-chip.representative { background: rgba(155,125,224,0.15); color: #9b7de0; border: 1px solid #9b7de0; }

.sim-onscene-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; margin-bottom: 14px; }
.sim-onscene-card { background: var(--cork); border-radius: 6px; padding: 9px 11px; }
.sim-onscene-head { display: flex; justify-content: space-between; align-items: center; gap: 6px; margin-bottom: 4px; }
.sim-onscene-head strong { font-size: 0.85rem; }
.sim-onscene-headline { font-size: 0.8rem; color: var(--muted); line-height: 1.4; }

/* ======================= STATEMENT LEDGER TAB ======================= */
.lg-h { margin: 26px 0 4px; font-size: 1.05rem; }
.lg-sub { font-size: 0.82rem; color: var(--muted); margin: 0 0 14px; line-height: 1.5; }

.lg-conflict { background: var(--cork); border-radius: 8px; border-left: 4px solid #e05252; padding: 14px 16px; margin-bottom: 14px; }
.lg-cf-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
.lg-cf-head h4 { margin: 0; font-size: 0.98rem; color: #e05252; }
.lg-cf-count { font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--muted); background: rgba(224,82,82,0.12); border-radius: 3px; padding: 2px 8px; }
.lg-cf-row { display: flex; gap: 12px; padding: 9px 0; border-top: 1px solid rgba(255,255,255,0.06); }
.lg-cf-person { flex: 0 0 165px; font-size: 0.84rem; font-weight: 600; color: var(--fg); display: flex; align-items: flex-start; gap: 6px; flex-wrap: wrap; }
.lg-cf-body { flex: 1; }
.lg-cf-pos { font-size: 0.78rem; font-weight: 700; color: #e8b84b; text-transform: uppercase; margin-bottom: 3px; }
.lg-cf-claim { font-size: 0.84rem; color: var(--fg); line-height: 1.5; margin-bottom: 4px; }
.lg-cf-meta { font-size: 0.74rem; color: var(--muted); }

.lg-person { background: var(--cork); border-radius: 8px; padding: 14px 16px; margin-bottom: 14px; }
.lg-person-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
.lg-person-head h3 { margin: 0; font-size: 1rem; }
.lg-person-role { font-size: 0.78rem; color: var(--muted); }
.lg-person-stats { font-size: 0.74rem; color: var(--accent); margin-left: auto; white-space: nowrap; }
.lg-stmt { display: flex; gap: 12px; padding: 10px 0; border-top: 1px solid rgba(255,255,255,0.06); }
.lg-stmt-conflict { background: rgba(232,184,75,0.05); border-left: 3px solid #e8b84b; padding-left: 9px; margin-left: -12px; }
.lg-stmt-date { flex: 0 0 105px; font-size: 0.8rem; color: var(--accent); font-weight: 600; }
.lg-prec { display: block; font-size: 0.66rem; color: var(--muted); font-weight: 400; text-transform: uppercase; }
.lg-stmt-body { flex: 1; }
.lg-stmt-claim { font-size: 0.85rem; color: var(--fg); line-height: 1.5; margin-bottom: 6px; }
.lg-stmt-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-bottom: 5px; }
.lg-topic { font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--muted); background: rgba(255,255,255,0.06); border-radius: 3px; padding: 2px 7px; }
.lg-topic-conflict { color: #111; background: #e8b84b; }
.lg-grade { font-size: 0.68rem; font-weight: 800; color: #111; border-radius: 3px; padding: 1px 6px; }
.lg-venue { font-size: 0.74rem; color: var(--muted); }
.lg-stmt-verif { font-size: 0.76rem; color: var(--muted); line-height: 1.45; margin-bottom: 3px; }
.lg-stmt-src { font-size: 0.72rem; color: var(--muted); }
.lg-stmt-src a { color: var(--accent); }

.lg-cf-id, .lg-gt-id { font-size: 0.7rem; font-weight: 800; color: #111; background: var(--accent); border-radius: 3px; padding: 1px 6px; }
.lg-sev { font-size: 0.68rem; font-weight: 800; color: #111; border-radius: 3px; padding: 1px 7px; text-transform: uppercase; }
.lg-cf-class { font-size: 0.72rem; color: var(--muted); font-style: italic; }
.lg-sid { display: block; font-size: 0.66rem; color: var(--muted); font-weight: 400; }
.lg-cf-reason { font-size: 0.8rem; color: var(--fg); line-height: 1.5; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); }
.lg-ctype, .lg-fh { font-size: 0.7rem; color: var(--muted); background: rgba(255,255,255,0.05); border-radius: 3px; padding: 1px 6px; }

.lg-gt { background: var(--cork); border-radius: 8px; border-left: 4px solid #35c46b; padding: 12px 15px; margin-bottom: 10px; }
.lg-gt-head { display: flex; align-items: center; gap: 9px; margin-bottom: 6px; flex-wrap: wrap; }
.lg-gt-date { font-size: 0.74rem; color: var(--muted); margin-left: auto; }
.lg-gt-fact { font-size: 0.85rem; color: var(--fg); line-height: 1.5; margin-bottom: 5px; }
.lg-gt-note { font-size: 0.78rem; color: var(--muted); font-style: italic; line-height: 1.45; margin-bottom: 4px; }

.lg-pcov { background: var(--cork); border-radius: 8px; padding: 12px 15px; margin-bottom: 10px; border-left: 4px solid #52c7c1; }
.lg-pcov-gap { border-left-color: #e8b84b; }
.lg-pcov-head { display: flex; align-items: baseline; gap: 9px; margin-bottom: 6px; flex-wrap: wrap; }
.lg-pcov-role { font-size: 0.76rem; color: var(--muted); }
.lg-pcov-comp { font-size: 0.72rem; color: var(--accent); margin-left: auto; }
.lg-pcov-nums { display: flex; gap: 12px; flex-wrap: wrap; font-size: 0.74rem; color: var(--muted); margin-bottom: 6px; }
.lg-neg { color: #e05252; font-weight: 700; }
.lg-warn { color: #e8b84b; font-weight: 700; }
.lg-pos { color: #35c46b; font-weight: 700; }
.lg-pcov-cov, .lg-pcov-notes { font-size: 0.76rem; color: var(--muted); line-height: 1.45; }
.lg-pcov-need { font-size: 0.78rem; color: #e8b84b; margin-top: 5px; }

.lg-pri { display: flex; gap: 12px; align-items: flex-start; background: var(--cork); border-radius: 8px; padding: 12px 15px; margin-bottom: 9px; border-left: 4px solid var(--accent); }
.lg-pri-n { flex: 0 0 26px; height: 26px; border-radius: 50%; background: var(--accent); color: #111; font-weight: 800; font-size: 0.82rem; display: flex; align-items: center; justify-content: center; }
.lg-pri-assess { font-size: 0.8rem; color: var(--muted); line-height: 1.45; margin-top: 3px; }
.lg-pri-conf { font-size: 0.74rem; }
.lg-pri-next { font-size: 0.78rem; color: var(--accent); margin-top: 4px; line-height: 1.45; }

/* ======================= DEEP DIVES TAB ======================= */
.dd-card { background: var(--cork); border-radius: 8px; border-left: 4px solid #9aa1b1; padding: 18px 20px; margin-bottom: 16px; }
.dd-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 8px; }
.dd-head h3 { margin: 0; font-size: 1.05rem; }
.dd-quality { font-size: 0.78rem; color: var(--muted); margin-left: auto; }
.dd-summary { font-size: 0.9rem; color: var(--fg); line-height: 1.55; margin-bottom: 12px; }
.dd-findings { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
.dd-finding { background: rgba(0,0,0,0.15); border-radius: 6px; padding: 10px 13px; }
.dd-finding-head { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
.dd-assess-badge { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; padding: 2px 8px; border-radius: 4px; color: #111; white-space: nowrap; }
.dd-claim { font-size: 0.88rem; font-weight: 600; color: var(--fg); }
.dd-detail { font-size: 0.82rem; color: var(--muted); line-height: 1.5; margin: 0; }
.dd-takeaway { font-size: 0.85rem; color: var(--accent); line-height: 1.5; margin-bottom: 6px; }
.dd-updated { font-size: 0.75rem; color: var(--muted); }

.dd-doc-compare { background: rgba(0,0,0,0.12); border-radius: 6px; padding: 14px 16px; margin-bottom: 12px; }
.dd-doc-compare h4 { margin: 0 0 10px; font-size: 0.92rem; color: var(--accent); }
.dd-doc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 700px) { .dd-doc-grid { grid-template-columns: 1fr; } }
.dd-doc-ver { background: rgba(0,0,0,0.1); border-radius: 5px; padding: 10px 12px; }
.dd-doc-ver strong { font-size: 0.85rem; display: block; margin-bottom: 6px; color: var(--fg); }
.dd-doc-field { font-size: 0.82rem; color: var(--fg); margin-bottom: 3px; }
.dd-doc-field span:first-child { color: var(--muted); }
.dd-ok { color: #35c46b; font-weight: 600; }
.dd-err { color: #e05252; font-weight: 600; }
.dd-doc-note { font-size: 0.78rem; color: var(--muted); line-height: 1.4; margin-top: 6px; font-style: italic; }
.dd-doc-src { font-size: 0.72rem; color: var(--muted); margin-top: 4px; }

.dd-precedent { background: rgba(0,0,0,0.12); border-radius: 6px; padding: 14px 16px; margin-bottom: 12px; }
.dd-precedent h4 { margin: 0 0 8px; font-size: 0.88rem; color: var(--fg); }
.dd-precedent-answer { font-size: 0.85rem; color: #e8b84b; font-weight: 600; margin-bottom: 6px; }
.dd-precedent p { font-size: 0.82rem; color: var(--muted); line-height: 1.5; margin: 0 0 8px; }
.dd-precedent ul { margin: 0; padding-left: 18px; }
.dd-precedent li { font-size: 0.8rem; color: var(--muted); line-height: 1.45; margin-bottom: 4px; }
.dd-precedent-sig { font-size: 0.82rem; color: var(--fg); line-height: 1.5; margin-top: 8px; }

.dd-vbio { background: rgba(0,0,0,0.12); border-radius: 6px; padding: 14px 16px; margin-bottom: 12px; }
.dd-vbio h4 { margin: 0 0 10px; font-size: 0.92rem; color: #e05252; }
.dd-vbio-row { display: flex; gap: 12px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
.dd-vbio-row:last-child { border-bottom: none; }
.dd-vbio-key { flex: 0 0 150px; font-size: 0.78rem; color: var(--muted); font-weight: 600; }
.dd-vbio-val { flex: 1; font-size: 0.82rem; color: var(--fg); line-height: 1.45; }
.dd-vbio-none { color: #e05252; font-weight: 600; }

.dd-variants { background: rgba(0,0,0,0.12); border-radius: 6px; padding: 14px 16px; margin-bottom: 12px; }
.dd-variants h4 { margin: 0 0 6px; font-size: 0.92rem; color: #e05252; }
.dd-var-note { font-size: 0.79rem; color: var(--muted); line-height: 1.5; margin: 0 0 10px; }
.dd-variant { background: rgba(0,0,0,0.1); border-radius: 5px; padding: 10px 12px; margin-bottom: 8px; border-left: 3px solid #e8b84b; }
.dd-variant-none { border-left-color: #7a7f8c; opacity: 0.85; }
.dd-var-head { display: flex; align-items: baseline; gap: 9px; margin-bottom: 4px; flex-wrap: wrap; }
.dd-var-head strong { font-size: 0.84rem; }
.dd-var-sim { font-size: 0.72rem; color: var(--accent); margin-left: auto; }
.dd-var-claim { font-size: 0.81rem; color: var(--fg); line-height: 1.5; margin-bottom: 4px; }
.dd-var-src { font-size: 0.75rem; color: var(--muted); margin-bottom: 3px; }
.dd-var-status { font-size: 0.76rem; color: #e8b84b; line-height: 1.45; }
.dd-variant-none .dd-var-status { color: #9aa1b1; }

.dd-fc-gap { font-size: 0.82rem; color: #e09a52; line-height: 1.5; margin-bottom: 10px; padding: 8px 12px; background: rgba(224,154,82,0.08); border-radius: 5px; border-left: 3px solid #e09a52; }
.dd-ext-sources { font-size: 0.75rem; color: var(--muted); margin-bottom: 6px; }

.dd-route-math { background: rgba(0,0,0,0.12); border-radius: 6px; padding: 14px 16px; margin-bottom: 12px; }
.dd-route-math h4 { margin: 0 0 10px; font-size: 0.92rem; color: #ff9d5c; }
.dd-route-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; margin-bottom: 12px; }
@media (max-width: 700px) { .dd-route-grid { grid-template-columns: 1fr; } .dd-route-arrow { transform: rotate(90deg); } }
.dd-route-point { background: rgba(0,0,0,0.1); border-radius: 5px; padding: 10px 12px; }
.dd-route-point strong { font-size: 0.84rem; display: block; margin-bottom: 4px; color: var(--fg); }
.dd-route-arrow { text-align: center; font-size: 1.1rem; color: #ff9d5c; font-weight: 700; line-height: 1.3; }
.dd-route-arrow span { font-size: 0.72rem; color: var(--muted); font-weight: 400; }
.dd-route-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
.dd-route-stat { background: rgba(0,0,0,0.1); border-radius: 5px; padding: 8px 12px; flex: 1; min-width: 140px; }
.dd-route-stat span { display: block; font-size: 0.72rem; color: var(--muted); margin-bottom: 2px; }
.dd-route-stat strong { font-size: 0.88rem; color: var(--fg); }
.dd-route-shortfall { border-left: 3px solid #e05252; }
.dd-route-shortfall strong { color: #e05252; }

.dd-timeline-seq { background: rgba(0,0,0,0.12); border-radius: 6px; padding: 14px 16px; margin-bottom: 12px; }
.dd-timeline-seq h4 { margin: 0 0 10px; font-size: 0.92rem; color: #ff9d5c; }
.dd-tl-row { display: flex; gap: 12px; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
.dd-tl-row:last-child { border-bottom: none; }
.dd-tl-time { flex: 0 0 150px; font-size: 0.78rem; color: var(--accent); font-weight: 600; }
.dd-tl-event { flex: 1; font-size: 0.82rem; color: var(--fg); line-height: 1.45; }
.dd-tl-status { display: inline-block; margin-left: 8px; font-size: 0.68rem; text-transform: uppercase; font-weight: 700; color: var(--muted); background: rgba(255,255,255,0.06); border-radius: 3px; padding: 1px 6px; white-space: nowrap; }

/* ======================= INVESTIGATION PRIORITIES TAB ======================= */
.prio-top-section { margin-bottom: 24px; }
.prio-top-section h3 { margin-bottom: 12px; }
.prio-top-card { display: flex; gap: 14px; align-items: flex-start; background: var(--cork); border-radius: 8px; padding: 14px 16px; margin-bottom: 10px; border-left: 4px solid var(--accent); }
.prio-top-n { font-size: 1.4rem; font-weight: 800; color: var(--accent); min-width: 36px; }
.prio-top-card h4 { margin: 0 0 4px; font-size: 0.95rem; }
.prio-top-card p { margin: 0; font-size: 0.84rem; color: var(--muted); line-height: 1.5; }
.prio-biometric { background: rgba(78,161,255,0.1); border: 1px solid rgba(78,161,255,0.3); border-radius: 8px; padding: 16px 18px; margin-bottom: 20px; }
.prio-biometric h3 { margin: 0 0 8px; color: #4ea1ff; }
.prio-biometric p { font-size: 0.88rem; line-height: 1.5; }
.prio-chain { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 0.82rem; color: var(--accent); margin: 10px 0; font-weight: 600; }
.prio-biometric ul { font-size: 0.84rem; color: var(--muted); padding-left: 20px; }
.prio-tier { margin-bottom: 10px; }
.prio-tier summary { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: var(--cork); border-radius: 6px; border-left: 4px solid #9aa1b1; cursor: pointer; font-size: 0.9rem; }
.prio-tier-label { font-weight: 800; font-size: 0.82rem; text-transform: uppercase; }
.prio-tier-name { font-weight: 600; }
.prio-tier-count { margin-left: auto; font-size: 0.78rem; color: var(--muted); }
.prio-tier-items { padding: 8px 0 4px 18px; }
.prio-item { display: flex; gap: 10px; align-items: flex-start; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
.prio-id { font-size: 0.75rem; font-weight: 700; color: var(--muted); min-width: 28px; }
.prio-item-body { flex: 1; }
.prio-item-head { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; }
.prio-item-head strong { font-size: 0.85rem; }
.prio-badge { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; padding: 1px 7px; border-radius: 3px; color: #111; }
.prio-item p { margin: 0; font-size: 0.8rem; color: var(--muted); line-height: 1.45; }

/* ======================= VEHICLE ANALYSIS TAB ======================= */
.va-section { margin-bottom: 22px; }
.va-section h3 { margin-bottom: 10px; }
.va-confirmed { background: var(--cork); border-radius: 8px; padding: 14px 16px; }
.va-surv-card { background: var(--cork); border-radius: 8px; padding: 14px 16px; margin-bottom: 10px; border-left: 4px solid #e8b84b; }
.va-surv-card h5 { margin: 0 0 8px; font-size: 0.9rem; }
.va-disc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
.va-disc-card { background: rgba(224,82,82,0.08); border: 1px solid rgba(224,82,82,0.2); border-radius: 8px; padding: 14px 16px; }
.va-disc-card h4 { margin: 0 0 6px; font-size: 0.9rem; color: #e05252; }
.va-disc-card p { margin: 0; font-size: 0.84rem; color: var(--muted); line-height: 1.5; }
.va-person-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; margin-bottom: 12px; }
.va-person-card { background: var(--cork); border-radius: 8px; border-left: 4px solid #9aa1b1; padding: 14px 16px; }
.va-person-card h4 { margin: 0 0 8px; font-size: 0.88rem; }
.va-distortion { background: rgba(232,184,75,0.08); border: 1px solid rgba(232,184,75,0.2); border-radius: 8px; padding: 14px 16px; margin-bottom: 14px; }
.va-distortion h4 { margin: 0 0 6px; color: #e8b84b; font-size: 0.9rem; }
.va-distortion p { margin: 0; font-size: 0.84rem; color: var(--muted); line-height: 1.5; }

/* ======================= LATEST ASSESSMENT TAB ======================= */
.assess-headline { background: var(--cork); border-radius: 8px; padding: 16px 18px; margin-bottom: 18px; border-left: 4px solid var(--accent); }
.assess-headline h3 { margin: 0 0 6px; }
.assess-headline p { margin: 0; font-size: 0.92rem; line-height: 1.55; }
.assess-h { margin: 20px 0 10px; }
.conf-block { background: var(--cork); border-radius: 8px; padding: 16px 18px; margin-bottom: 18px; }
.conf-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.conf-label { min-width: 180px; font-size: 0.84rem; font-weight: 600; }
.conf-track { flex: 1; position: relative; height: 22px; background: rgba(255,255,255,0.06); border-radius: 4px; }
.conf-bar { position: absolute; top: 2px; height: 18px; border-radius: 3px; opacity: 0.85; }
.conf-range { position: absolute; right: 8px; top: 2px; font-size: 0.75rem; font-weight: 700; line-height: 18px; }
.stream-table th { white-space: nowrap; width: 160px; }
.stream-weak { margin-top: 4px; font-size: 0.8rem; color: #e8b84b; }
.anomaly-card { background: var(--cork); border-radius: 8px; padding: 14px 16px; margin-bottom: 10px; border-left: 4px solid #e8b84b; }
.anomaly-card.sev-3, .anomaly-card.sev-high { border-left-color: #e05252; }
.anomaly-card.sev-1, .anomaly-card.sev-low { border-left-color: #52c7c1; }
.anomaly-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.anomaly-head h4 { margin: 0; font-size: 0.92rem; }
.anomaly-status { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: #e8b84b; }
.anomaly-finding { margin: 0; font-size: 0.84rem; color: var(--muted); line-height: 1.5; }
.security-block { background: var(--cork); border-radius: 8px; padding: 16px 18px; margin-bottom: 14px; }
.security-facts { font-size: 0.86rem; padding-left: 20px; line-height: 1.6; }
.security-warn { background: rgba(224,82,82,0.08); border: 1px solid rgba(224,82,82,0.2); border-radius: 6px; padding: 10px 14px; margin-top: 10px; font-size: 0.84rem; }
.security-counter { background: rgba(78,161,255,0.08); border: 1px solid rgba(78,161,255,0.2); border-radius: 6px; padding: 10px 14px; margin-top: 8px; font-size: 0.84rem; }
.trends-expl { display: flex; gap: 12px; align-items: flex-start; background: var(--cork); border-radius: 8px; padding: 12px 14px; margin-bottom: 8px; }
.te-rank { font-size: 1.2rem; font-weight: 800; color: var(--accent); min-width: 28px; }
.trends-expl h5 { margin: 0 0 3px; font-size: 0.88rem; }
.trends-expl p { margin: 0; font-size: 0.82rem; color: var(--muted); line-height: 1.45; }
.would-change { background: rgba(232,184,75,0.06); border: 1px solid rgba(232,184,75,0.15); border-radius: 8px; padding: 14px 18px; }
.would-change ul { font-size: 0.86rem; padding-left: 20px; line-height: 1.6; }
.next-milestone { background: rgba(78,161,255,0.08); border: 1px solid rgba(78,161,255,0.25); border-radius: 8px; padding: 16px 18px; margin-top: 18px; }
.next-milestone h4 { margin: 0 0 6px; color: #4ea1ff; }
.next-milestone p { margin: 0; font-size: 0.88rem; line-height: 1.5; }

.dd-hyps { background: rgba(0,0,0,0.12); border-radius: 6px; padding: 14px 16px; margin-bottom: 12px; }
.dd-hyps h4 { margin: 0 0 10px; font-size: 0.92rem; color: #f07ba8; }
.dd-hyp { background: rgba(0,0,0,0.1); border-radius: 5px; padding: 11px 13px; margin-bottom: 9px; border-left: 3px solid #f07ba8; }
.dd-hyp-head { display: flex; align-items: center; gap: 9px; margin-bottom: 5px; flex-wrap: wrap; }
.dd-hyp-rank { flex: 0 0 22px; height: 22px; border-radius: 50%; background: #f07ba8; color: #111; font-weight: 800; font-size: 0.78rem; display: flex; align-items: center; justify-content: center; }
.dd-hyp-head strong { font-size: 0.87rem; }
.dd-hyp-conf { margin-left: auto; font-size: 0.76rem; font-weight: 700; color: #e8b84b; white-space: nowrap; }
.dd-hyp-sum { font-size: 0.8rem; color: var(--muted); line-height: 1.5; margin-bottom: 8px; }
.dd-hyp-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 760px) { .dd-hyp-cols { grid-template-columns: 1fr; } }
.dd-hyp-lbl { font-size: 0.7rem; text-transform: uppercase; font-weight: 800; margin-bottom: 4px; }
.dd-hyp-for .dd-hyp-lbl { color: #35c46b; }
.dd-hyp-against .dd-hyp-lbl { color: #e05252; }
.dd-hyp-cols ul { margin: 0; padding-left: 16px; }
.dd-hyp-cols li { font-size: 0.78rem; color: var(--muted); line-height: 1.45; margin-bottom: 4px; }
